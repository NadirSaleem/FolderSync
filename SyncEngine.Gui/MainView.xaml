<UserControl
    x:Class="FolderSync.Gui.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FolderSync.Gui"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <local:SyncModeDescriptionConverter x:Key="SyncModeDescriptionConverter" />
    </UserControl.Resources>

    <Grid Padding="0" ColumnSpacing="16" Background="#14284C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: pair list -->
        <Grid Grid.Column="0" RowSpacing="8" Padding="16,16,0,16" Background="#0A1930">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Folder pairs" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ListView
                Grid.Row="1"
                x:Name="PairsList"
                ItemsSource="{x:Bind ViewModel.Pairs}"
                SelectedItem="{x:Bind ViewModel.SelectedPair, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FolderPairViewModel">
                        <Grid ColumnSpacing="8" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" MinWidth="0" Margin="0,0,-8,0"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Include this pair in batch Preview/Run" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Opacity="0.7" TextTrimming="CharacterEllipsis" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Add pair" Command="{x:Bind ViewModel.AddPairCommand}" />
                <Button Content="Remove" Command="{x:Bind ViewModel.RemovePairCommand}" />
            </StackPanel>
        </Grid>

        <!-- Right: detail + preview/run -->
        <Grid Grid.Column="1" RowSpacing="12" Padding="0,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Detail form -->
            <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="12"
                  Visibility="{x:Bind ViewModel.SelectedPair, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.SelectedPair.Name, Mode=TwoWay}" />

                <!-- Left/right folders, side by side -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Left Folder:" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="0" Symbol="Folder" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedPair.LeftPath, Mode=TwoWay}" />
                        </Grid>
                        <Button Content="Browse…" Click="BrowseLeft_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Right Folder:" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="0" Symbol="Folder" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SelectedPair.RightPath, Mode=TwoWay}" />
                        </Grid>
                        <Button Content="Browse…" Click="BrowseRight_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mode" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{x:Bind SyncModes}"
                          SelectedItem="{x:Bind ViewModel.SelectedPair.Mode, Mode=TwoWay}" />
                <Button Grid.Row="2" Grid.Column="2" Content="Save" Command="{x:Bind ViewModel.SaveEditsCommand}" />

                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{x:Bind ViewModel.SelectedPair.Mode, Mode=OneWay, Converter={StaticResource SyncModeDescriptionConverter}}"
                           TextWrapping="Wrap" Opacity="0.75" FontSize="14" />
            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Preview" Command="{x:Bind ViewModel.PreviewCommand}" />
                <Button Content="Run" Command="{x:Bind ViewModel.RunCommand}" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="Preview/Run act on every checked pair in the list on the left."
                           Opacity="0.6" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- Plan list -->
            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Plan}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ActionRow">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind PairName}" Opacity="0.8" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind TypeLabel}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Reason}" Opacity="0.7" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Status -->
            <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
